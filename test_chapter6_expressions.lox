// CHAPTER 5-6: PARSING EXPRESSIONS TEST
// Tests the parser's ability to handle complex expressions with proper precedence

print "=== CHAPTER 5-6: PARSING EXPRESSIONS ===";
print "";

// Literals
print "1. Literals:";
print 42;
print 3.14;
print "string";
print true;
print false;
print nil;
print "";

// Unary operators
print "2. Unary Operators:";
print -5;
print !true;
print !false;
print !!true;
print -(-10);
print "";

// Arithmetic operators
print "3. Arithmetic:";
print 1 + 2;
print 5 - 3;
print 4 * 3;
print 10 / 2;
print 2 + 3 * 4;
print (2 + 3) * 4;
print "";

// Comparison operators
print "4. Comparisons:";
print 5 > 3;
print 5 < 3;
print 5 >= 5;
print 5 <= 5;
print 5 == 5;
print 5 != 3;
print "";

// String operations
print "5. String Operations:";
print "Hello" + " " + "World";
print "Answer: " + "42";
print "";

// Complex expressions
print "6. Complex Expressions:";
print 2 + 3 * 4 - 5;
print (2 + 3) * (4 - 5);
print 1 + 2 + 3 + 4;
print 10 / 2 / 5;
print "";

// Grouping
print "7. Grouping:";
print (1 + 2) * 3;
print 1 + (2 * 3);
print ((1 + 2) * 3) - 4;
print "";

// Equality chains
print "8. Equality:";
print 1 == 1;
print 1 != 2;
print "hello" == "hello";
print "hello" != "world";
print true == true;
print true != false;
print "";

print "=== ALL EXPRESSION TESTS PASSED ===";
