fun makeAccount(initialBalance) {
  var balance = initialBalance;

  fun deposit(amount) {
    balance = balance + amount;
    return balance;
  }

  fun withdraw(amount) {
    if (balance >= amount) {
      balance = balance - amount;
      return balance;
    }
    return nil;
  }

  fun getBalance() {
    return balance;
  }

  fun account(op, amount) {
    if (op == "deposit") return deposit(amount);
    if (op == "withdraw") return withdraw(amount);
    if (op == "balance") return getBalance();
  }

  return account;
}

var myAccount = makeAccount(100);
print myAccount("balance", 0);     // 100
myAccount("deposit", 50);
print myAccount("balance", 0);     // 150
myAccount("withdraw", 30);
print myAccount("balance", 0);     // 120