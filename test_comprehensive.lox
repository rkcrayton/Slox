// CHAPTER 8: Variables and State
print "=== VARIABLES & STATE ===";
var x = 10;
var y = 20;
print x + y;
x = 15;
print x;
{
  var x = 100;
  print x;
}
print x;
print "";

// CHAPTER 9: Control Flow
print "=== CONTROL FLOW ===";
if (x > 10) print "x is large"; else print "x is small";
print true and false;
print true or false;

var i = 0;
while (i < 3) {
  print i;
  i = i + 1;
}

for (var j = 0; j < 3; j = j + 1) {
  print j;
}
print "";

// CHAPTER 10: Functions
print "=== FUNCTIONS ===";

fun add(a, b) {
  return a + b;
}
print add(5, 3);

fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}
print fib(7);

fun makeCounter() {
  var count = 0;
  fun counter() {
    count = count + 1;
    return count;
  }
  return counter;
}
var counter = makeCounter();
print counter();
print counter();
print counter();
print "";

// REAL-WORLD EXAMPLE: FizzBuzz-like pattern
print "=== COMPLEX EXAMPLE ===";
fun describe(n) {
  if (n > 10) return "large";
  if (n > 5) return "medium";
  return "small";
}

for (var num = 1; num <= 12; num = num + 1) {
  print describe(num);
}
print "";

// CLOSURE EXAMPLE: Bank Account
print "=== BANK ACCOUNT (CLOSURES) ===";
fun makeAccount(initialBalance) {
  var balance = initialBalance;
  
  fun deposit(amount) {
    balance = balance + amount;
    print "Deposited " + amount;
    return balance;
  }
  
  fun withdraw(amount) {
    if (balance >= amount) {
      balance = balance - amount;
      print "Withdrew " + amount;
      return balance;
    }
    print "Insufficient funds";
    return balance;
  }
  
  fun getBalance() {
    return balance;
  }
  
  // Return a "class-like" object
  fun account(operation, amount) {
    if (operation == "deposit") return deposit(amount);
    if (operation == "withdraw") return withdraw(amount);
    if (operation == "balance") return getBalance();
  }
  
  return account;
}

var myAccount = makeAccount(100);
print "Initial balance:";
print myAccount("balance", 0);
myAccount("deposit", 50);
print myAccount("balance", 0);
myAccount("withdraw", 30);
print myAccount("balance", 0);
myAccount("withdraw", 200);
print myAccount("balance", 0);
print "";

print "======================================";
print "  ALL TESTS PASSED!";
print "  INTERPRETER FULLY FUNCTIONAL!";
print "======================================";
